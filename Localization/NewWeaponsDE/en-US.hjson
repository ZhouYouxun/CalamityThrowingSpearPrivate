		NewWeapons: {
			DPreDog: {
				BloodstoneJav: {
					DisplayName: Bloodforged Fang
					Tooltip: "[GFB]"
					TooltipGFB:
						'''
						Hold left-click to continuously consume your life in exchange for increased pierce and damage  
						Right-click to unleash a fan of ricocheting spears toward the cursor  
						Restores health on enemy hit  
						Apparently, it actually works against DoG  
						[c/cc0e11:“Let me borrow your life. I swear I’ll give it back... someday.”]
						'''
					TooltipNormal:
						'''
						Hold left-click to continuously consume your life in exchange for increased pierce and damage  
						Right-click to unleash a fan of ricocheting spears toward the cursor  
						Restores health on enemy hit  
						No way someone’s actually using this thing against DoG, right? LMAO  
						[c/cc0e11:“Let me borrow your life. I swear I’ll give it back... someday.”]
						'''
				}

				ChaosWindJav: {
					DisplayName: Voltic Storm
					Tooltip:
						'''
						Throw a gravity-affected high-energy storm cannon that generates a magnetic orb at its origin  
						If it doesn’t hit an enemy within 1.5 seconds, it unleashes a massive explosion and a surge of lightning  
						If it hits early, only a small blast and fewer lightning bolts are triggered  
						[c/6d63e0:“Look up. No seriously—look up again.”]
						'''
				}

				ElementalArkJav: {
					DisplayName: Kitelemental Ark
					Tooltip:
						'''
						[c/ffd700:Throws elemental shards in different trajectories in cycles of five.]
						[c/ffd700:The fifth throw releases both a glaive and shards	, returning at the endpoint and causing a large rend.]
						[c/ffa500:Right-click to sacrifice a large amount of health for multiple reality cuts.]
						Modified by someone, this divine artifact reveals even greater power,
						but at the cost of the user's wellbeing.
						[c/ff0000:If four Permanent Health Upgrades items have been consumed,]
						[c/ff0000:the health sacrifice causes more severe repercussions.]
						[c/aa5fff:"All things have value,no one can escape."]
						'''
				}

				EndlessDevourJav: {
					DisplayName: Ceaseless Maw
					Tooltip:
						'''
						Hold to charge, then throw  
						If charge time is under 150 frames, fires a homing projectile  
						If over 150, creates a powerful supermassive black hole  
						The black hole constantly spews dark ions and deals massive damage  
						[c/D3D3D3:“Theoretically inescapable, but this one's clearly defective.”]
						'''
				}

				InfiniteDarknessJav: {
					DisplayName: Umbral Slip
					Tooltip:
						'''
						Quickly vanishes and reappears beside the enemy, striking with a spear and throwing starry shurikens  
						Deals greater damage if it hits an enemy before vanishing  
						[c/492861:“No dodge. No warning.”]
						'''
				}

				SoulHunterJav: {
					DisplayName: Soul Hunter
					Tooltip: "[GFB]"
					TooltipGFB: Counselor, your butt’s up in the tree—it doesn’t hurt anymore.
					TooltipNormal:
						'''
						The spear dashes once toward the nearest enemy while airborne.
						On hit, it generates Soul Hunter clones that persist around the area.
						After a short delay, triggers a massive abyssal explosion and summons 3 homing Soulsharks.
						If no enemies are found, it returns to the player and restores HP.
						[c/2836a1:"Brother! I’m here to end you!"]
						'''
				}

				TerraLance: {
					DisplayName: The Terraternal
					Tooltip:
						'''
						Releases a Terra explosion upon hitting an enemy  
						Also summons multiple infinitely-piercing Terra beams around the impact  
						[c/89ff69:“An emerald splash, half a screen in radius.”]
						'''
				}

				NuclearFuelRod: {
					DisplayName: Nuclear Tempest
					Tooltip:
						'''
						Aims and unleashes a tremendously powerful nuclear laser with infinite piercing  
						Releases a barrage of projectiles during the attack  
						Has a 30-second cooldown  
						[c/95b47c:“I am become Death, the fryer of eggs.”]
						'''
				}

				Sunset: {
					DisplayName: Sunset
					Tooltip: "[Stage]"
					DisplayNameS0: Sunset
					TooltipS0:
						'''
						The crimson spear, burning with twilight.
						Left-click — unleash a four-strike volley, each spear detonating into a miniature starburst.
						Right-click — raise the spear to the heavens, gathering the light of every star,
						As a newborn sun, collapsing into a cataclysmic explosion.

						— This is the sight he cherished most,
						made beautiful by her presence, burning in his grasp.
						At the very end, he crushed the cosmos into a single sun,
						only to share one final sunset with her.

						① When carried alongside other auxiliary weapons,  
						   the spear brands its wielder with searing flames;  
						   but when borne alone, it cleanses every curse in silence.  

						② The firmer the defense, the lighter the wound—  
						   true protection and the power of renewal grow ever stronger.  

						③ When defense falls to zero, with only wings and mobility trinkets to hold the sky,  
						   the spear awakens, bestowing a ruinous boon:  
						   damage, penetration, and critical chance surge,  
						   speed sharpens, yet immunity and endurance are stripped away,  
						   until the final strike blooms with fourfold annihilation.
						'''
					DisplayNameS1: Forget-Me-Not
					TooltipS1:
						'''
						The blue spear, a flower of memory.
						Left-click — scatter luminous bolts, summoning spectral tendrils that lash again and again.
						Right-click — hide the spear within the hand, calling forth shards and tentacles,
						closing around the foe in a merciless cage.

						— She followed him through countless resets of the timeline,
						trying to free him from the script of fate.
						As his memory of her faded away, only the forget-me-nots remained,
						whispering softly across eternity:  
						“Please, don’t forget me.”

						① When carried alongside other auxiliary weapons,  
						   the spear brands its wielder with searing flames;  
						   but when borne alone, it cleanses every curse in silence.  

						② The firmer the defense, the lighter the wound—  
						   true protection and the power of renewal grow ever stronger.  

						③ When defense falls to zero, with only wings and mobility trinkets to hold the sky,  
						   the spear awakens, bestowing a ruinous boon:  
						   damage, penetration, and critical chance surge,  
						   speed sharpens, yet immunity and endurance are stripped away,  
						   until the final strike blooms with fourfold annihilation.
						'''
					DisplayNameS2: Concept
					TooltipS2:
						'''
						The silver-gold spear, manifestation of dominion.
						Switching to this form — ten fragments of inspiration rise and orbit your body.
						Left-click — whirl the spear in a deadly dance, then raise it high;
						a vast magic circle brands the enemy, gnawing at its soul,
						while the fragments dive into the seal, weaving a storm of ruin.
						Right-click — lock onto the nearest foe, summoning falling shards of time.
						Every thirty shards merge into a colossal timebreaker,
						crashing down from above to shatter space itself.

						— This is his true power:
						beyond all limits, ruling over everything.
						Even “concepts” themselves bow at the tip of his spear.

						① When carried alongside other auxiliary weapons,  
						   the spear brands its wielder with searing flames;  
						   but when borne alone, it cleanses every curse in silence.  

						② The firmer the defense, the lighter the wound—  
						   true protection and the power of renewal grow ever stronger.  

						③ When defense falls to zero, with only wings and mobility trinkets to hold the sky,  
						   the spear awakens, bestowing a ruinous boon:  
						   damage, penetration, and critical chance surge,  
						   speed sharpens, yet immunity and endurance are stripped away,  
						   until the final strike blooms with fourfold annihilation.
						'''
				}
			}

			EAfterDog: {
				AuricJav: {
					DisplayName: Auric Quantum Overcharged Debug Rod
					Tooltip:
						'''
						Upon hitting an enemy, releases six piercing cooldown batteries to both sides and stores charge  
						Cooldown batteries deal no damage in their first 12 frames  
						Right-click to consume charge and launch a fast-tracking bouncing lightning orb  
						[c/fff994:“Whose genius idea was it to slap a battery onto a stick?”]  
						[c/fff994:“I'm gonna help him *cool down* that big ol' brain of his.”]
						'''
				}

				FinishingTouch: {
					DisplayName: Dragon's Ascent
					Tooltip:
						'''
						Left-click to throw a lance that releases a series of shockwaves along its path, dealing repeated damage.
						Every ninth thrown lance empowers the tenth one.
						The empowered lance transforms into a dragon after flying a distance, then crashes down with force.
						Right-click to raise the lance, summoning a dragon and several dragon orbs.
						After charging for a time, both the dragon and orbs dash toward the cursor.
						At the end of the dash, all orbs are launched forward and then home in on enemies after a delay.
						If you find this spear too chatty, you can mute it in the [c/d3d3d3:Config Settings][c/ffa500::(]
						[c/ff7335:“My name... is Quixote!I,Don Quixote,declare upon my honor:this lance shall end that hollow,juvenile dream!”]
						'''
				}

				MiracleMatterJav: {
					DisplayName: Eternal Radiance
					Tooltip:
						'''
						Sticks to enemies or tiles and deals continuous damage.
						Explodes into multiple homing energy blasts upon disappearing.
						Right-click to manually detonate all spears stuck in tiles.
						[c/757575:"It’s a little lighter than the one next door."]
						'''
				}

				TheOtherMiracleMatterJav: {
					DisplayName: Horizon Probe
					Tooltip:
						'''
						Throws a slow-moving lance that explodes on impact, summoning lasers and fire from above.
						If it doesn't hit anything after flying for a while, it returns to the player.
						During the return phase, it gains infinite piercing.
						[c/757575:"It’s a bit heavier than the one next door."]
						'''
				}

				SawBladeForkHornJav: {
					DisplayName: SBFHL
					Tooltip:
						'''
						Saw Blade Forked Horn Lance
						Charge in hand for three seconds before throwing it
						Pierces infinitely during its flight
						Shatters the defense and damage reduction of enemies on hit
						Each hit grants the player stackable defense and damage reduction buffs
						Right-click to consume the stackable buffs, throwing the weapon to hover in the air for additional support attacks
						[c/645c02:"The simplest logic, the most brutal effect."]
						'''
				}

				ShadowJav: {
					DisplayName: Infinity Boundless
					Tooltip:
						'''
						Left-click to throw the lance.
						After flying a short distance, it splits into 2–4 random lances at its position,
						only selecting lances from this mod (excluding developer weapons).
						The splitting lances ignore the original lance's limitations (e.g., Pearlwood Spear's one-lance limit).
						The main lance continues flying after splitting, piercing infinitely.
						Right-click to shoot a lance that tracks and attaches to enemies,
						summoning random lances around it during its attachment.
						While the attached lance exists, clicking left or right will remove it and re-release the lance.
						[c/8f8f8f:"Encompassing Universe,Interlacing Qiankun"]
						'''
				}

				Revelation: {
					DisplayName: Revelation
					Tooltip:
						'''
						Hold down left-click to grip the Revelation, releasing it after one second if you hold up the left-click.
						Releasing earlier than one second reduces damage; the shorter the time, the greater the penalty.
						Right-click to manually destroy an existing Revelation.
						Hitting enemies five times increases the weapon’s level, starting at level 0.
						Level 0—Small explosion on hit.
						Level 1—Small increase to damage, speed, and explosion range.
						Level 2—Significant glow, major damage increase, and tracking light bolts accompany its flight.
						Level 3—Further damage increase, explosion form change, and elemental mix in explosions.
						Level 4—Further speed increase, explosions release numerous tracking comets.
						Taking damage or missing enemies will decrease one level.
						Unequipping the weapon clears its ALL level; re-equipping it does NOT restore levels.
						[c/494949:"Condensed with all of humanity's technology, incomprehensible to outsiders."]
						'''
				}

				SoulSeekerJav: {
					DisplayName: Apex Remnant
					Tooltip:
						'''
						Upon hitting an enemy, begins spiraling and continuously releases fireballs.
						Each hit summons one Supreme Soul Seeker, which orbits the player.
						These orbiters deal contact damage and perform coordinated strikes alongside the lance.
						Right-click to command all orbiters to dash at enemies, applying a one-second Vulnerability Hex.
						Up to 10 Supreme Soul Seekers can exist; at full count, the lance deals increased damage on hit.
						Obtained by performing necromantic infusion on the Gilded Proboscis, reversible via Shimmer.
						[c/630000:"The dragon is a Whispering spiral, drawing fundamental power from the world's fractured soul, growing relentlessly until the finale."]
						'''
				}

				PrimordialState: {
					DisplayName: Yin-Yang Genesis
					Tooltip:
						'''
						Begins homing after flying for a short while.  
						During this phase, generates a Yin-Yang Orb every 12 frames.  
						Each orb continuously follows the lance and deals rapid damage.  
						After homing ends, the lance darts off in a random direction,  
						emitting additional orbs on departure.  
						Orbs bounce on impact and detonate in dual-aspect explosions.  
						[c/e1ffff:"Thus comes judgment—there is no gray."]  
						[c/2f2f2f:"Yet truth lies hidden between the black and white."]  
						'''
				}

				StarsofDestiny: {
					DisplayName: Chronoseeker
					Tooltip:
						'''
						Left-click hurls the Clock Lance's long hand, forming a temporal array.
						Right-click releases the short hand, a seeker that hunts targets on its own.
						Each left-click strike inscribes a Time Mark, and every mark empowers your next right-click attack.
						Hold the Up key while attacking to call down a sudden rain of stars.
						[c/e1ffff:"The Queen of Snow and Sea mistook you for her beloved."]  
						'''
				}

				TEM00: {
					DisplayName: Fundamental Gaussian Mode
					Tooltip:
						'''
						Left-click: unleash continuous sweeping laser sequences; after five cycles, fire a final converging beam
						Right-click: summon orbiting laser emitters that auto-target nearby enemies and release dense laser fire
						While held, deploys a high-dimensional construct, placing all players under its defensive calculations.
						Note: requires activation on first use
						[c/00fff0:“I glimpsed the end in a single moment.”]
						'''
				}
			}
		}
	}
}
