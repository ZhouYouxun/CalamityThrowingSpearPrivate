		ModBuff: {
			SagittariusEDebuff: {
				DisplayName: Sagittarius Flare
				Description:
					'''
					Reduces attack power by 30% during the day and defense power by 50% at night
					Whether it is day or night, this is not a good thing for the enemy
					'''
			}

			CreateVictoryPEBuff: {
				DisplayName: Create Victory
				Description: Loses a lot of health and defense
			}

			SawBladeForkHornEDebuff: {
				DisplayName: Comminuted Fracture
				Description:
					'''
					Just like the name
					Comminuted Fracture
					'''
			}

			SawBladeForkHornPBuff: {
				DisplayName: Theory of Defense Expansion
				Description:
					'''
					Stackable defense power!
					Surprising? Unexpected?
					'''
			}

			TheLastLancePBuff: {
				DisplayName: Charge Form
				Description:
					'''
					The past died on the land, and neither the present nor the future have any meaning. 
					Only the ocean; kill the ocean. 
					'''
			}

			FinishingTouch10PBuff: {
				DisplayName: Finishing Touch10 P Buff
				Description: Mods.CalamityThrowingSpear.ModBuff.FinishingTouch10PBuff.Description
			}
		}

		Configs: {
			CTSConfigs: {
				DisplayName: CTS Configs

				EnableFTSound: {
					Label: Enable custom voice for some weapons
					Tooltip:
						'''
						All weapons with voice in the current version:
						Dragon's Ascent
						'''
				}

				EnableMeleeSpeed: {
					Label: Melee Speed Control (Need to reload)
					Tooltip:
						'''
						After turning on this option, all weapons in this mod will NOT be affected by the melee attack speed bonus. 
						Vice versa
						'''
				}

				EnableRogue: {
					Label: EnableRogue
					Tooltip:
						'''
						Changed all weapons class type to Rogue
						It will not include new forms of attacks
						'''
				}

				MeleeSpeedMultiplierMode: {
					Label: Global Melee Speed Scaling
					Tooltip:
						'''
						Change how this mod's weapons
						are affected by melee speed bonuses,
						and to what extent.
						'''
				}
			}

			CTSRecipeConfigs: {
				DisplayName: CTS Recipe Configs

				DeveloperWeaponsCraftable: {
					Label: Developer Weapons Craftable
					Tooltip:
						'''
						Makes developer weapons easier to obtain.
						Requires reload.
						'''
				}
			}
		}

