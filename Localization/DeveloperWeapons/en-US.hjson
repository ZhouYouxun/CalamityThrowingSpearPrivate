Mods: {
	CalamityThrowingSpear: {
		DeveloperWeaponPanels: {
			Guide: {
				Subtitle: Mod guide
				Acquisition:
					'''
					This mod contains thrown variants for Calamity's original spears.
					Go to Settings > Controls > Mod Controls > Switch Spear.
					Hold a thrusting spear and press the switch key to swap to its thrown variant, and vice versa.

					Credits, in no particular order:
					Nan Yuan Bei Sheng, Ju Jiao, VectorChaos, Zhongmo Yharon, Home Computer, Muxue Ningchun Yukimu, Zhongzi Xing Endticle Star.
					'''
			}

			TheLastLance: {
				Subtitle: Tablet record: An execution without witnesses
				Acquisition:
					'''
					Tablet clue: obtained by killing enemies while in the Ocean biome.
					Weapon: kill a Seahorse with an Anchor to obtain The Last Lance.
					'''
			}

			Sagittarius: {
				Subtitle: Tablet record: Sagittarius
				Acquisition:
					'''
					Tablet clue: challenge the Empress of Light before the Lunatic Cultist is defeated. The tablet is awarded whether the challenge succeeds or fails.
					Weapon: defeat the Empress of Light in that encounter while taking no more than 4 hits to obtain Starpiercer - Sagittarius.
					Helper recipe: available when the server config Developer Weapons Craftable is enabled.
					'''
			}

			TidalMechanics: {
				Subtitle: Tablet record: A paleobiological oceanography paper
				Acquisition:
					'''
					Tablet clue: challenge Duke Fishron before the Lunatic Cultist is defeated. The tablet is awarded whether the challenge succeeds or fails.
					Weapon: defeat Duke Fishron within 120 seconds to obtain Tidal.
					Helper recipe: available when the server config Developer Weapons Craftable is enabled.
					'''
			}

			ElementalArk: {
				Subtitle: Tablet record: Proverb of Starnight
				Acquisition:
					'''
					Tablet clue: obtained when the third mechanical boss is defeated.
					Weapon: defeat the Moon Lord without consuming any of Calamity's four permanent fruit boosters to obtain Kitelemental Ark.
					Helper recipe: available when the server config Developer Weapons Craftable is enabled.
					'''
			}

			FinishingTouch: {
				Subtitle: Tablet record: Dragon Nirvana
				Acquisition:
					'''
					Tablet clue: obtained by defeating Dragonfolly, or by triggering the Yharon event while holding Snake Embellishment before Yharon reaches phase two.
					Weapon: when Yharon reaches the required health threshold, holding Snake Embellishment triggers the falling event; the event projectile drops Dragon's Ascent when it ends.
					A Cosmic Anvil recipe also exists. Enabling Developer Weapons Craftable removes Ashes of Annihilation from that recipe.
					'''
			}

			Revelation: {
				Subtitle: Tablet record: Revelation - Part I
				Acquisition:
					'''
					Tablet clue: obtained by defeating the Devourer of Gods.
					Weapon: drop Ultima and Starmada into the world at the same time; they merge into Revelation.
					Helper recipe: available when the server config Developer Weapons Craftable is enabled.
					'''
			}

			StarsOfDestiny: {
				Subtitle: Tablet record: A Wondrous Journey
				Acquisition:
					'''
					Tablet clue: obtained by defeating Polterghast.
					Weapon: after Polterghast is defeated, right-click the Astral Beacon while holding a Gold Watch or Platinum Watch to obtain Chronoseeker. The watch is consumed.
					Helper recipe: available when the server config Developer Weapons Craftable is enabled.
					'''
			}

			SunsetSeed: {
				Subtitle: Seed record: Sunset
				Acquisition:
					'''
					Clue source: defeat Providence at night for a 50% chance to drop the seed.
					Weapon: plant Grass Seed, wait for it to reach its final stage, then break the plant to obtain Sunset.
					The current code advances growth by in-game days. If the intended rule is exactly 49 days, the growth thresholds still need to be unified to 49.
					'''
			}
		}

