			StarsofDestinyPBuff: {
				DisplayName: Chrono Regeneration
				Description:
					'''
					Slightly increases movement speed and life regeneration
					Your time begins to accelerate!
					'''
			}

			StarsofDestinyEDebuff: {
				DisplayName: Chrono Mark
				Description:
					'''
					The target is marked by time
					Takes increased damage from you
					'''
			}

			StarsofDestinyP2Buff: {
				DisplayName: Temporal Shelter
				Description:
					'''
					Greatly shortens the duration of negative debuffs
					Grants minor life regeneration
					Time bends in your favor
					'''
			}

			SurfeiterDrumEDebuff: {
				DisplayName: Surfeiter Drum E Debuff
				Description: Mods.CalamityThrowingSpear.Buffs.SurfeiterDrumEDebuff.Description
			}

			SunsetCConceptPBuff: {
				DisplayName: Concept Dominion
				Description:
					'''
					The crown of logic brushes against your thoughts
					Abstract power quietly rewrites your fate
					'''
			}

			SunsetBForgetPBuff: {
				DisplayName: Eternal Affection
				Description:
					'''
					Forget-me-not petals drift across your palm
					Gentle memories form a protective embrace
					'''
			}

			SunsetBForgetEDebuff: {
				DisplayName: Dream Reversion
				Description:
					'''
					Tears return to their very first coordinates
					The target is trapped within an echoing dream
					'''
			}

			SunsetASunsetEDebuff: {
				DisplayName: Sunset Afterglow
				Description:
					'''
					The last light of dusk settles upon the grass
					The target withers beneath the fading glow
					'''
			}
		}

		TheSpecialText: {
			ElementalArkJav2: ingested too many pigments
