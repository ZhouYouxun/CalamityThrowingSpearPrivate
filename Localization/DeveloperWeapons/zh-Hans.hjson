Mods: {
	CalamityThrowingSpear: {
		DeveloperWeaponPanels: {
			Guide: {
				Subtitle: 模组说明
				Acquisition:
					'''
					本模组内含所有原灾长枪的投掷版本。
					请前往 设置 > 控制按键 > 配置自定义按键 > 更改长枪形态。
					手持戳刺长枪按下切换键，可以切换至对应版本的投掷长枪，反之亦然。

					感谢以下人员对 mod 作出的贡献，排名不分先后：
					南鸢北笙、锯角、VectorChaos、终末犽戎、家庭电脑、沐雪凝春Yukimu、终子星Endticle Star。
					'''
			}

			TheLastLance: {
				Subtitle: 石板记录：一场没有人见证的处决
				Acquisition:
					'''
					线索石板：在海洋群系击杀敌怪时获得。
					武器获取：使用锚击杀海马，即可获得“最后的骑枪”。
					'''
			}

			Sagittarius: {
				Subtitle: 石板记录：人马座
				Acquisition:
					'''
					线索石板：在拜月教徒被击败前挑战光之女皇，无论挑战成功与否都会获得。
					武器获取：在同一场光之女皇战斗中受击不超过 4 次并击败她，即可获得“贯星枪-人马座”。
					辅助配方：开启服务器配置“开发者武器可制作”后可制作。
					'''
			}

			TidalMechanics: {
				Subtitle: 石板记录：某一篇古生物海洋学研究论文
				Acquisition:
					'''
					线索石板：在拜月教徒被击败前挑战猪龙鱼公爵，无论挑战成功与否都会获得。
					武器获取：在 120 秒内击败猪龙鱼公爵，即可获得“潮汐”。
					辅助配方：开启服务器配置“开发者武器可制作”后可制作。
					'''
			}

			ElementalArk: {
				Subtitle: 石板记录：星夜箴言
				Acquisition:
					'''
					线索石板：击败第三个机械 Boss 时获得。
					武器获取：不吃灾厄的四种永久水果，之后击败月球领主，即可获得“鸢素方舟”。
					辅助配方：开启服务器配置“开发者武器可制作”后可制作。
					'''
			}

			FinishingTouch: {
				Subtitle: 石板记录：鳞蛇化龙
				Acquisition:
					'''
					线索石板：击败痴愚金龙，或在犽戎进入二阶段前手持“画蛇添足”触发事件。
					武器获取：犽戎血量降至指定阶段时，手持“画蛇添足”会触发坠落事件；事件弹幕结束后掉落“画龙点睛”。
					也存在宇宙砧配方；开启服务器配置“开发者武器可制作”后会移除配方中的湮灭余烬需求。
					'''
			}

			Revelation: {
				Subtitle: 石板记录：启示录-前篇
				Acquisition:
					'''
					线索石板：击败神明吞噬者时获得。
					武器获取：将“创世纪”和“群星大炮”同时丢在世界中，二者会被合成为“启示录”。
					辅助配方：开启服务器配置“开发者武器可制作”后可制作。
					'''
			}

			StarsOfDestiny: {
				Subtitle: 石板记录：不思议之旅
				Acquisition:
					'''
					线索石板：击败噬魂幽花时获得。
					武器获取：击败噬魂幽花后，手持金怀表或铂金怀表右键星辉信标，即可获得“命定星启”，怀表会被消耗。
					辅助配方：开启服务器配置“开发者武器可制作”后可制作。
					'''
			}

			SunsetSeed: {
				Subtitle: 种子记录：落日
				Acquisition:
					'''
					线索来源：夜晚击败亵渎天神，普罗维登斯时，种子有 50% 概率掉落。
					武器获取：种下“小草种子”，等待其成长到最终阶段后敲掉植物，即可获得“落日”。
					当前代码按游戏日推进成长阶段；若需要严格“七七四十九天”，还需要把成长阈值统一调整为 49 天。
					'''
			}
		}

